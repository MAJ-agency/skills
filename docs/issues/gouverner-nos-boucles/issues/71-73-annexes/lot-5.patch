+    --ouverte "$(jq -r '.created_at // ""' <<<"$pr")" --tete "$sommet" --branche "$(jq -r .head.ref <<<"$pr")" --commentaires "$commentaires" && rc=0 || rc=$?
+  rm -f "$commentaires"
+  return "$rc"
+}
