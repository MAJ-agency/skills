+revue_du_capitaine() {
+  local pr=$1 sommet=$2 base=$3 fichiers brut='[]' commentaires rc=0
+  fichiers=$(cat)
+  # Sans la clé `relecture` sur la base, la PR est en régime 7 quelle que soit sa date : rien à relire ni à lire de plus
