+// Le ticket de la PR, sur develop, qui accorde `scripts/agent/**` (la garde des fichiers sensibles, lot 5b).
+const TICKET = "docs/features/demo/all/issues/SPEC_ALL_DEMO-1-demo.01.issue.md";
