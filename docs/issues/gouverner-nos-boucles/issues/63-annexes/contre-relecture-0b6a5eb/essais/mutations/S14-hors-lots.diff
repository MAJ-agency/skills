+  for i in $(seq 1 "$n"); do dire "lot $( [ "$nom" = lot ] && echo "$i" || echo "$nom-$i") : $(lignes "$R/$nom-$i/relus.txt") fichiers, $(lignes "$R/$nom-$i/diff.patch") lignes, {{DIFF}} : $R/$nom-$i/diff.patch"; done
   if [ "$nom" = lot ]; then dire "lots : $n"; else dire "lots de la résolution : $n"; fi
 }
 
@@ -596,8 +597,8 @@ lus() {
     d=$B/lots/resolution axe=$B/axe-1-lot-resolution.txt
