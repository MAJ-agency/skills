@@ -353,7 +353,8 @@ binaires_resolution() {
 # à jour, la résolution (`lots resolution.patch resolution.txt resolution`, lots `lots/resolution-<j>/`), chacun dans
 # son dossier de travail : le cas « un seul lot » ne retire que le sien.
 lots() {
