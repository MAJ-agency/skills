+
+function sensible(fichiers, base) {
+  if (fichiers === null) return true;
+  if (fichiers.length === 0) return false;
+  const r = jouer('node', [join(CHAINE, 'chemins-sensibles.mjs'), `origin/${base}`], { input: `${fichiers.join('\n')}\n` });
