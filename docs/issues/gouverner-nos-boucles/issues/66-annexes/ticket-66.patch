+  for (const relecture of [{ depuis: 'demain' }, { depuis: '2026-11-20T09:00:00Z', delai: 0 }, { depuis: '2026-11-20T09:00:00Z', sensible: { modele: 'opus', effort: 'fort' } }, null]) {
+    const m = monter({ contrat: { relecture } });
