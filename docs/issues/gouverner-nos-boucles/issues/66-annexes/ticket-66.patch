+  assert.deepEqual(sans.json(sans.lancer('passe')).map((g) => [g.pr, g.geste, g.raison]), [[12, 'hors-regime', 'régime 7']]);
+  const d = monter();
+  pr(d, { ouverte: '2026-11-20T08:59:00Z' });
