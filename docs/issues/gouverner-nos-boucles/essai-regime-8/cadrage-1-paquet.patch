@@ -0,0 +1,19 @@
+// Le partage d'un montant en parts égales (RULE_ALL_PAR-1) : des centimes entiers, dont la somme
+// est toujours le montant partagé ; les centimes du reste vont aux premières parts, un chacune.
+
+/**
+ * Partage `totalCents` en `parts` parts égales au centime près : 1000 en 3 → [334, 333, 333].
+ * Refuse (RangeError) un montant qui n'est pas un entier positif ou nul, et un nombre de parts qui
+ * n'est pas un entier d'au moins 1.
+ */
+export function splitEvenly(totalCents, parts) {
+  if (!Number.isInteger(totalCents) || totalCents < 0)
+    throw new RangeError(
+      `montant à partager attendu en centimes entiers, positif ou nul : ${totalCents}`,
+    );
+  if (!Number.isInteger(parts) || parts < 1)
+    throw new RangeError(`nombre de parts attendu entier, d'au moins 1 : ${parts}`);
+  const base = Math.floor(totalCents / parts);
+  const remainder = totalCents - base * parts;
+  return Array.from({ length: parts }, (_, i) => (i < remainder ? base + 1 : base));
+}
diff --git a/packages/essai/src/split.test.mjs b/packages/essai/src/split.test.mjs
new file mode 100644
index 0000000..08418d0
--- /dev/null
+++ b/packages/essai/src/split.test.mjs
@@ -0,0 +1,58 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { splitEvenly } from "./split.mjs";
+
+const sum = (list) => list.reduce((a, b) => a + b, 0);
+
+describe("[RULE_ALL_PAR-1] splitEvenly", () => {
+  it("partage un montant divisible en parts égales", () => {
+    assert.deepEqual(splitEvenly(900, 3), [300, 300, 300]);
+  });
+
+  it("donne les centimes du reste aux premières parts, un chacune", () => {
+    assert.deepEqual(splitEvenly(1000, 3), [334, 333, 333]);
+  });
+
+  it("garde la somme des parts égale au montant partagé", () => {
+    for (const [total, parts] of [
+      [1, 2],
+      [999, 7],
+      [100001, 13],
+      [5, 9],
+    ])
+      assert.equal(sum(splitEvenly(total, parts)), total);
+  });
+
+  it("ne fait jamais différer deux parts de plus d'un centime", () => {
+    const shares = splitEvenly(100001, 13);
+    assert.ok(Math.max(...shares) - Math.min(...shares) <= 1);
+  });
+
+  it("rend le montant entier pour une seule part", () => {
+    assert.deepEqual(splitEvenly(1234, 1), [1234]);
+  });
+
+  it("rend des parts nulles pour un montant nul", () => {
+    assert.deepEqual(splitEvenly(0, 4), [0, 0, 0, 0]);
+  });
+
+  it("rend des parts nulles et des parts d'un centime quand il y a plus de parts que de centimes", () => {
+    assert.deepEqual(splitEvenly(2, 4), [1, 1, 0, 0]);
+  });
+
+  it("refuse un montant négatif", () => {
+    assert.throws(() => splitEvenly(-1, 2), RangeError);
+  });
+
+  it("refuse un montant qui n'est pas entier", () => {
+    assert.throws(() => splitEvenly(10.5, 2), RangeError);
+  });
+
+  it("refuse zéro part", () => {
+    assert.throws(() => splitEvenly(100, 0), RangeError);
+  });
+
+  it("refuse un nombre de parts qui n'est pas entier", () => {
+    assert.throws(() => splitEvenly(100, 2.5), RangeError);
+  });
+});
