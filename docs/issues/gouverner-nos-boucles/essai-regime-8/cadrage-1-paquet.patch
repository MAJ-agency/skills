+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { parseAmount } from "./cents.mjs";
+
+describe("parseAmount", () => {
+  it("lit un montant à deux décimales séparées par une virgule", () => {
+    assert.equal(parseAmount("12,34"), 1234);
+  });
+
+  it("lit un montant à deux décimales séparées par un point", () => {
+    assert.equal(parseAmount("12.34"), 1234);
+  });
+
+  it("complète une seule décimale d'un zéro", () => {
+    assert.equal(parseAmount("12,5"), 1250);
+  });
+
+  it("lit un montant sans décimale", () => {
+    assert.equal(parseAmount("7"), 700);
+  });
+
+  it("lit un montant nul", () => {
+    assert.equal(parseAmount("0"), 0);
+  });
+
+  it("lit 0,10 et 0,20 sans erreur d'arrondi", () => {
+    assert.equal(parseAmount("0,10") + parseAmount("0,20"), 30);
+  });
+
+  it("refuse plus de deux décimales", () => {
+    assert.throws(() => parseAmount("1,234"), RangeError);
+  });
+
+  it("refuse un montant négatif", () => {
+    assert.throws(() => parseAmount("-1"), RangeError);
+  });
+
+  it("refuse un texte vide", () => {
+    assert.throws(() => parseAmount(""), RangeError);
+  });
+
+  it("refuse un séparateur sans décimale", () => {
+    assert.throws(() => parseAmount("12,"), RangeError);
+  });
+
+  it("refuse un montant au-delà des entiers sûrs", () => {
+    assert.throws(() => parseAmount("90071992547409.92"), RangeError);
+  });
+
+  it("refuse ce qui n'est pas un texte", () => {
+    assert.throws(() => parseAmount(12), TypeError);
+  });
+});
