+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { formatCents } from "./format.mjs";
+
+describe("formatCents", () => {
+  it("écrit les centimes après une virgule et le symbole après une espace insécable", () => {
+    assert.equal(formatCents(1234), "12,34 €");
+  });
+
+  it("écrit deux chiffres de centimes quand il y en a moins de dix", () => {
+    assert.equal(formatCents(705), "7,05 €");
+  });
+
+  it("écrit un montant nul", () => {
+    assert.equal(formatCents(0), "0,00 €");
+  });
+
+  it("sépare les milliers par une espace insécable fine", () => {
+    assert.equal(formatCents(123456789), "1 234 567,89 €");
+  });
+
+  it("refuse un montant négatif", () => {
+    assert.throws(() => formatCents(-1), RangeError);
+  });
+
+  it("refuse un montant qui n'est pas entier", () => {
+    assert.throws(() => formatCents(12.5), RangeError);
+  });
+});
diff --git a/packages/essai/src/split.mjs b/packages/essai/src/split.mjs
