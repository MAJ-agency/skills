diff --git a/packages/essai/src/cents.mjs b/packages/essai/src/cents.mjs
new file mode 100644
index 0000000..e2b5f36
--- /dev/null
+++ b/packages/essai/src/cents.mjs
@@ -0,0 +1,19 @@
+// Montant écrit par une personne → centimes entiers. Aucun flottant ne sort d'ici : les centimes
+// se lisent chiffre par chiffre, jamais par `parseFloat`, qui arrondit (`0.1 + 0.2`).
+
+const AMOUNT = /^(\d+)(?:[.,](\d{1,2}))?$/;
+
+/**
+ * Lit un montant positif ou nul, écrit avec au plus deux décimales, séparées par une virgule ou
+ * un point (« 12,34 », « 12.5 », « 7 »), et le rend en centimes entiers (1234, 1250, 700).
+ * Refuse (RangeError) tout le reste : texte vide, signe, plus de deux décimales, espace, lettre.
+ */
+export function parseAmount(text) {
+  if (typeof text !== "string") throw new TypeError("le montant attendu est un texte");
+  const match = AMOUNT.exec(text);
+  if (!match) throw new RangeError(`montant illisible : « ${text} »`);
+  const [, units, decimals = ""] = match;
+  const cents = Number(units) * 100 + Number(decimals.padEnd(2, "0"));
+  if (!Number.isSafeInteger(cents)) throw new RangeError(`montant trop grand : « ${text} »`);
+  return cents;
+}
