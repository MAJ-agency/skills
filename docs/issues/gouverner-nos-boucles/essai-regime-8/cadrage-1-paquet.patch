@@ -0,0 +1,18 @@
+// Centimes entiers → montant affiché, en français : virgule décimale, espace insécable fine entre
+// les milliers, espace insécable avant le symbole. Le calcul se fait sur des entiers, jamais par
+// `toFixed`, qui passe par un flottant.
+
+const THOUSANDS = " ";
+const BEFORE_SYMBOL = " ";
+
+/** Rend « 1 234,56 € » pour 123456 ; refuse (RangeError) ce qui n'est pas un entier sûr positif ou nul. */
+export function formatCents(cents) {
+  if (!Number.isSafeInteger(cents) || cents < 0)
+    throw new RangeError(`centimes attendus en entier positif ou nul : ${cents}`);
+  const units = String(Math.floor(cents / 100));
+  const decimals = String(cents % 100).padStart(2, "0");
+  const groups = [];
+  for (let end = units.length; end > 0; end -= 3)
+    groups.unshift(units.slice(Math.max(0, end - 3), end));
+  return `${groups.join(THOUSANDS)},${decimals}${BEFORE_SYMBOL}€`;
+}
