{
  "$comment": "Fragment à fusionner dans la clé `hooks` de .claude/settings.json : les matchers s'ajoutent à ceux de graphify, ils ne les remplacent pas.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/agent/garde-fichiers.mjs",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/agent/garde-commandes.mjs",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(push_files|create_or_update_file|delete_file|create_branch|merge_pull_request|enable_pr_auto_merge|update_pull_request_branch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/agent/garde-github.mjs",
            "timeout": 40,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/agent/demarrage.mjs",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/agent/apres-edition.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/agent/fin-de-tour.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
