{
  "name": "@{{SCOPE}}/{{PROJET}}-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src --max-warnings 0",
    "test": "vitest run",
    "check:cycles": "dpdm --no-warning --no-tree --exit-code circular:1 --tsconfig tsconfig.json \"app/**/*.tsx\" \"src/**/*.{ts,tsx}\"",
    "check:bundle": "expo export --platform android --output-dir .expo/export-check",
    "check:gates": "pnpm check:bundle",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@{{SCOPE}}/{{PROJET}}-contracts": "workspace:*",
    "@expo/metro-runtime": "~57.0.15",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.20.0",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "dpdm": "^4.2.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "expo-doctor": "^1.13.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
